{% extends 'base.html.twig' %}

{% block title %}  Minics | Votre panier {% endblock %}

{% block body %}
<div class="container my-5">
    <table class="table table-borderless">
        <theader>
            <tr>
                <th>Photo</th>
                <th>Titre</th>
                <th>Referance</th>
                <th>Categorie</th>
                <th>Quantity</th>
                <th>Prix unitaire</th>
                <th> Prix total</th>
                <th></th>

            </tr>
        </theader>
        <tbody>
        {% if dataCart is empty %}
                <tr>
                    <td colspan="7" class="text-center">Aucun article dans le panier</td>
                </tr>
        {% else %}

            {% for item in dataCart %}
            	<tr>
							{# <td><img src="" alt="" class="picture__product"></td> #}
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
				</tr>

            {% endfor %}

        {% endif %}
        </tbody>
    </table>
</div>


{% endblock %}
