{% extends 'base.html.twig' %}

{% block title %}
	Minics | Détails de l'article
{% endblock %}

{% block body %}

	<h1 class="text-center my-4">Nos produits</h1>

	<div class="container my-5 d-flex">
		<div class="img-box mr-4">
			<img src="{{ asset('uploads/images/' ~ product.picture) }}" alt="{{ product.title }}">
		</div>
		<div class="details-box">
		<h5>
		{{ product.title }}
		</h5>
			<h5>
				Référence :
				{{ product.reference }}
			</h5>
			<h5>
				Catégorie :
				{{ product.category.title }}
			</h5>
			<h5>
				Couleur :
				{{ product.color }}
			</h5>
			<h5>
				Genre :
				{{ product.gender }}
			</h5>
			<h5>
				Mémoire :
				{{ product.size }}
			</h5>
			<h5>
				Description :
				{{ product.description }}
			</h5>
			{% if product.stock %}

				{% if product.stock <= 5 %}

				Plus que 
				{{product.stock }}
				articles disponible

				{% endif %}
				
			
				<form action="{{ path('app_cart_add', {'id': product.id}) }}" method="post" class="d-flex align-items-center mt-4">
					<div class="form-group m-0">

					<select name="quantity" id="quantity" class="form-contol">
					 {% for item in 1..product.stock %}

					     {# {{dump(item)}} #}

						 {%  if item <= product.stock and item <= 10 %}

						<option value="{{ item }}"> {{ item }}</option>
						{% endif %}

						{% endfor %} 
					</select>

					<button type="submit" class="ml-2 btn btn-dark"> Ajouter au panier</button>
					</div>
				</form>

			{% else %}
				<i class="text-danger"> Rupture de stock </i> 
			{% endif %}


		</div>
				
	</div>



{% endblock %}
 