{% extends 'base.html.twig' %}

{% block title %}Log in!
{% endblock %}

{% block body %}

	<div class="col-12 col-sm-8 col-md-6 col-lg-4 mx-auto my-4">
		<form method="post">
			{% if error %}
				<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
			{% endif %}

			<h1 class="h3 mb-3 font-weight-normal">Identifiez-vous</h1>

			<label for="username">Email</label>
			<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control mb-2" autocomplete="email" required autofocus>


			<label for="password">Mot de passe</label>
			<input type="password" name="_password" id="password" class="form-control mb-2" autocomplete="current-password" required>

			<input
			type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

	
			<button class="btn btn-lg btn-dark" type="submit">
				Continuer
			</button>
		</form>
	</div>
{% endblock %}